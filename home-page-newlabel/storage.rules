rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 誰でも読み取り可能（公開コンテンツ用）
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // 管理者のみアップロード可能
    match /audio/{fileName} {
      allow write: if request.auth != null && 
                     request.auth.token.email_verified == true &&
                     request.auth.token.email in ['askeybar.official@gmail.com'];
    }
    
    match /images/{allPaths=**} {
      allow write: if request.auth != null && 
                     request.auth.token.email_verified == true &&
                     request.auth.token.email in ['askeybar.official@gmail.com'];
    }
  }
}