rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 公開コンテンツは誰でも読み取り可能
    match /songs/{songId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 書き込みはサーバー (Firebase Admin SDK) 経由のみ。Admin SDK はルールを迂回する。
    // それ以外のコレクションは全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
