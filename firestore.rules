rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email in ['askeybar.official@gmail.com'];
    }

    // 公開コンテンツは誰でも読み取り可能、書き込みは管理者のみ許可
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /designs/{designId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // それ以外のコレクションは全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
